rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isAuthed() && request.auth.uid == uid;
    }
    // Admins may be represented by any legacy/current admin marker.
    // We read from the existing doc so a user cannot self-promote by writing.
    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return isAuthed() &&
        (
          currentUserDoc().data.isAdmin == true
          || currentUserDoc().data.role == 'admin'
          || (
            currentUserDoc().data.roles is list
            && 'admin' in currentUserDoc().data.roles
          )
        );
    }
    function hasRole(role) {
      return isAuthed()
        && currentUserDoc().data.roles is list
        && role in currentUserDoc().data.roles;
    }
    function isContentManager() {
      return isAdmin() || hasRole('admin') || hasRole('content-manager') || hasRole('contentManager');
    }
    function currentTier() {
      return currentUserDoc().data.subscriptionTier == 'elite' || currentUserDoc().data.tier == 'elite'
        ? 'elite'
        : currentUserDoc().data.subscriptionTier == 'pro' || currentUserDoc().data.tier == 'pro'
          ? 'pro'
          : 'explorer';
    }
    function tierRank(tier) {
      return tier == 'elite' ? 2 : tier == 'pro' ? 1 : 0;
    }
    function canReadEvent() {
      return isAdmin()
        || (
          isAuthed()
          && resource.data.status in ['scheduled', 'live', 'completed']
          && (
            resource.data.visibility in ['all', 'explorer']
            || (resource.data.visibility in ['pro', 'elite'] && tierRank(currentTier()) >= tierRank(resource.data.visibility))
            || (
              resource.data.visibility == 'custom'
              && resource.data.allowedTiers is list
              && currentTier() in resource.data.allowedTiers
            )
          )
        );
    }
    function academyEnrollmentId(courseId) {
      return request.auth.uid + '_' + courseId;
    }
    function isAcademyEnrolled(courseId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/academyEnrollments/$(academyEnrollmentId(courseId)))
        && get(/databases/$(database)/documents/academyEnrollments/$(academyEnrollmentId(courseId))).data.status in ['active', 'completed'];
    }
    function isPublishedAcademyCourse(courseId) {
      return exists(/databases/$(database)/documents/academyCourses/$(courseId))
        && get(/databases/$(database)/documents/academyCourses/$(courseId)).data.status == 'published';
    }
    function canReadAcademyContent(courseId) {
      return isAdmin() || (isPublishedAcademyCourse(courseId) && isAcademyEnrolled(courseId));
    }

    // String validation helpers
    function isValidString(value, maxLength) {
      return value is string && value.size() <= maxLength && value.size() > 0;
    }
    function isValidOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    // ── Deny everything by default ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    // Public read (needed for landing page stats & community feed).
    // Only the author may create their own posts; no one can change authorId.
    // Authors may edit content; admins may pin/unpin.
    match /posts/{postId} {
      allow read: if true;

      allow create: if isAdmin()
        || (
          isAuthed()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'authorAvatar', 'authorTier', 'authorRole',
            'isFounder', 'content', 'channel', 'tags', 'type', 'isPinned',
            'likeCount', 'commentCount', 'imageUrl', 'linkUrl', 'reactionCounts',
            'createdAt', 'updatedAt'
          ])
          // Validate required fields
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 5000
          // Enforce safe defaults on creation
          && request.resource.data.isPinned == false
          && request.resource.data.likeCount == 0
          && request.resource.data.commentCount == 0
          // Validate optional fields
          && isValidOptionalString(request.resource.data.imageUrl, 2048)
          && isValidOptionalString(request.resource.data.linkUrl, 2048)
          && (request.resource.data.channel == null || request.resource.data.channel is string)
        );

      // Author can edit content/tags/type but NOT authorId, likeCount, or commentCount.
      // Must be within 30 minutes of creation (or be admin)
      allow update: if isAuthed()
        && resource.data.authorId == request.auth.uid
        && (
          isAdmin()
          || (request.time - resource.data.createdAt) < duration.value(30, "m")
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['content', 'tags', 'type', 'channel', 'linkUrl', 'editedAt', 'isEdited', 'updatedAt'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.isPinned == resource.data.isPinned
        && request.resource.data.createdAt == resource.data.createdAt
        // Validate content length on update
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000;

      // Allow authenticated users to update likeCount/reactionCounts (for reactions)
      // and commentCount (for comments) - only increment/decrement by 1
      allow update: if isAuthed()
        && (
          // Only likeCount and reactionCounts are changing (reaction transaction)
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount', 'reactionCounts', 'updatedAt'])
            && (
              request.resource.data.likeCount == resource.data.likeCount + 1
              || request.resource.data.likeCount == resource.data.likeCount - 1
              || request.resource.data.likeCount == resource.data.likeCount
            )
          )
          ||
          // Only commentCount is changing (comment transaction)
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['commentCount', 'updatedAt'])
            && (
              request.resource.data.commentCount == resource.data.commentCount + 1
            )
          )
          ||
          // Soft delete (author only)
          (
            resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'content', 'deletedAt', 'updatedAt'])
            && request.resource.data.deleted == true
            && request.resource.data.content == '[deleted]'
          )
        );

      // Admin-only updates (pin/unpin, full post edits)
      allow update: if isAdmin();

      allow delete: if isAuthed() && resource.data.authorId == request.auth.uid
        || isAdmin();
    }

    // ── Comments (posts subcollection) ────────────────────────────────────────
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;

      allow create: if isAuthed()
        && request.resource.data.keys().hasOnly([
          'postId', 'authorId', 'authorName', 'authorAvatar', 'authorTier',
          'content', 'parentId', 'replyCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.postId == postId
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000;

      allow update: if isAuthed()
        && (
          (
            resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['content', 'editedAt', 'isEdited', 'updatedAt'])
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.content is string
            && request.resource.data.content.size() <= 2000
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
            && request.resource.data.replyCount == resource.data.replyCount + 1
          )
        );

      allow delete: if isAuthed() && resource.data.authorId == request.auth.uid
        || isAdmin();
    }

    // ── Reactions / Likes ─────────────────────────────────────────────────────
    // Doc ID is "{userId}_{postId}" — enforced by the rule below.
    match /likes/{likeId} {
      allow read: if true;

      // Only the owner can create/update their own reaction
      allow create, update: if isAuthed()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.type in ['like', 'love', 'funny', 'wow', 'sad', 'fire']
        && request.resource.data.keys().hasOnly(['postId', 'userId', 'type', 'createdAt', 'updatedAt'])
        && likeId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_-]+$');

      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }

    // ── User Profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();

      // New profile: must own the doc and may only create an Explorer/member profile.
      allow create: if isUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.tier == 'explorer'
        && request.resource.data.subscriptionTier == 'explorer'
        && request.resource.data.subscriptionPlan == 'explorer'
        && request.resource.data.subscriptionStatus == 'active'
        && request.resource.data.subscription.provider in ['system', 'free']
        && request.resource.data.subscription.userId == userId
        && request.resource.data.subscription.subscriptionPlan == 'explorer'
        && request.resource.data.subscription.plan == 'explorer'
        && request.resource.data.subscription.planId == 'explorer'
        && request.resource.data.subscription.subscriptionStatus == 'active'
        && request.resource.data.subscription.status == 'active'
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('role', 'member') == 'member'
        && (!request.resource.data.keys().hasAny(['roles']) ||
            (request.resource.data.roles is list && !('admin' in request.resource.data.roles)));

      // Self-updates are intentionally allowlisted. Entitlement, billing, and admin
      // fields are written only by trusted server code/Admin SDK.
      allow update: if isUser(userId)
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['missions', 'postCount', 'commentCount', 'likeCount', 'engagementScore', 'updatedAt'])
          ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'displayName', 'photoURL', 'avatarURL', 'avatarUrl', 'selectedIdentity', 'updatedAt'])
          ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['growthAssessmentDismissed', 'growthAssessmentResult', 'ownsLegacyBuilders', 'engagementScore', 'updatedAt'])
          ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pushSubscriptions', 'updatedAt'])
        );

      // Admins may update anything (tier upgrades, subscription writes from backend)
      allow update: if isAdmin();

      allow delete: if isAdmin();

      // ── Mentor History (private to owner) ──────────────────────────────────
      match /mentorHistory/{threadId} {
        allow read, write: if isUser(userId);

        // Messages inside a thread
        match /messages/{messageId} {
          allow read, write: if isUser(userId);
        }
      }

      // ── Roadmaps (private to owner) ────────────────────────────────────────
      match /roadmaps/{roadmapId} {
        allow read, write: if isUser(userId);
      }

      // ── Missions (private to owner) ───────────────────────────────────────
      match /missions/{missionId} {
        allow read: if isUser(userId);
        allow create, update, delete: if false;
      }

      // ── Notifications (private to owner) ─────────────────────────────────
      match /notifications/{notificationId} {
        allow read, update, delete: if isUser(userId);
        allow create: if isUser(userId)
          && request.resource.data.type in ['info', 'success', 'warning', 'like', 'comment', 'reply', 'mission', 'mentor', 'subscription', 'welcome']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 500
          && request.resource.data.linkUrl is string
          && request.resource.data.linkUrl.size() <= 500
          && request.resource.data.readAt == null
          && request.resource.data.createdAt == request.time;
      }

      match /following/{targetUserId} {
        allow read: if isUser(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /followers/{viewerUserId} {
        allow read: if isUser(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /hiddenPosts/{postId} {
        allow read: if isUser(userId);
        allow create, update, delete: if false;
      }

      // ── XP Event Logs (server-validated) ──────────────────────────────────
      match /xpEvents/{eventId} {
        allow read: if isUser(userId);
        allow create: if false; // XP events are written by trusted backend functions only.
        allow update, delete: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;

      match /following/{targetUserId} {
        allow read: if true;
        allow write: if false;
      }

      match /followers/{viewerUserId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /postReports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketplaceAssets/{assetId} {
      // Allow authenticated users to query marketplace assets
      // List/get operations: allow query to execute, filtering happens at query level
      allow list: if isAuthed();
      // Get single doc: check published flag or is content manager
      allow get: if resource.data.published == true || isContentManager();
      allow create, update, delete: if isContentManager();
    }

    match /assetPurchases/{purchaseId} {
      allow read: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid)
        || (isAuthed() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /resellerLinks/{linkId} {
      allow read: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /resellerSales/{saleId} {
      allow read: if isAdmin()
        || (isAuthed() && resource.data.resellerUserId == request.auth.uid)
        || (isAuthed() && resource.data.buyerUserId == request.auth.uid);
      allow write: if false;
    }

    match /resellerPayoutProfiles/{profileId} {
      allow read: if isAdmin() || isUser(profileId);
      allow write: if false;
    }

    match /socialAccounts/{accountId} {
      allow read: if isAuthed() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /socialAccountSecrets/{accountId} {
      allow read, write: if false;
    }

    match /socialOAuthStates/{stateId} {
      allow read, write: if false;
    }

    match /socialOAuthHandshakes/{handshakeId} {
      allow read, write: if false;
    }

    match /aiProviderConnections/{connectionId} {
      allow read, write: if false;
    }

    match /creatorCreditAccounts/{accountId} {
      allow read, write: if false;
    }

    match /creatorCreditLedger/{entryId} {
      allow read, write: if false;
    }

    match /aiUsageEvents/{eventId} {
      allow read, write: if false;
    }

    match /aiUsageBudgets/{budgetId} {
      allow read, write: if false;
    }

    match /aiSemanticCache/{cacheId} {
      allow read, write: if false;
    }

    match /aiOrchestrationOutcomes/{traceId} {
      allow read, write: if false;
    }

    match /aiProviderMetrics/{metricId} {
      allow read, write: if false;
    }

    match /aiStudioArtifacts/{artifactId} {
      allow read, write: if false;
    }

    // ── Admin Audit Log ──────────────────────────────────────────────────────
    match /scheduledPosts/{postId} {
      allow read: if isAuthed() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /socialPostAnalytics/{analyticsId} {
      allow read: if isAuthed() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /socialAnalyticsSnapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /socialPublishingControls/{ownerId} {
      allow read: if isAuthed() && ownerId == request.auth.uid;
      allow write: if false;
    }

    match /socialAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /socialReliabilityAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /socialPublishFingerprints/{fingerprintId} {
      allow read, write: if false;
    }

    match /socialPublishUserDailyLimits/{limitId} {
      allow read, write: if false;
    }

    match /socialPublishProviderRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read: if canReadEvent();
      allow write: if false;

      match /rsvps/{userId} {
        allow read: if isAdmin() || isUser(userId);
        allow create, update, delete: if false;
      }

      match /attendance/{userId} {
        allow read: if isAdmin() || isUser(userId);
        allow write: if false;
      }
    }

    match /academyCourses/{courseId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if false;
    }

    match /academyTopics/{topicId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academyLessons/{lessonId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academyActivities/{activityId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academyActivitySubmissions/{submissionId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyQuizzes/{quizId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academyQuizAttempts/{attemptId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyQuizResponses/{responseId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyExamAttempts/{attemptId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyEnrollments/{enrollmentId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyProgress/{progressId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyCertificates/{certificateId} {
      allow read: if resource.data.status == 'active' || isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyRecommendations/{recommendationId} {
      allow read: if isAdmin() || (isAuthed() && isPublishedAcademyCourse(resource.data.courseId));
      allow write: if false;
    }

    match /academyCohorts/{cohortId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academyLiveSessions/{sessionId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academySessionAttendance/{attendanceId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
  
    match /academyLessonDiscussions/{discussionId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academyDiscussionReplies/{replyId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academyDiscussionReactions/{reactionId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyDripSchedules/{scheduleId} {
      allow read: if canReadAcademyContent(resource.data.courseId);
      allow write: if false;
    }

    match /academyManualReviews/{reviewId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyTutorMessages/{messageId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyTutorSessions/{sessionId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /academyImports/{importId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── System Config ───────────────────────────────────────────────────────
    match /system/{document} {
      allow read: if true; // Allow checking setup status
      allow write: if isAdmin();
    }
  }
}
